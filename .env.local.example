# The whole file. Written by `npx convex dev` — copy it, then run that.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Everything else lives on the Convex deployment, not here, because the
# functions that use it run there:
#
#   npx convex env set MODEL_API_KEY ...       what the interns think with
#   npx convex env set MODEL_BASE_URL ...      optional, defaults to Groq
#   npx convex env set MODEL_NAME ...          optional, defaults to openai/gpt-oss-20b
#   npx convex env set AUTH_GITHUB_ID ...      GitHub sign-in
#   npx convex env set AUTH_GITHUB_SECRET ...
#   npx convex env set SITE_URL ...            where the OAuth callback returns
#
# `npx convex env list` prints them back (with values — careful). See
# HANDOVER.md's "Model provider" section for where to get each model key and
# the Gemini/OpenAI alternative values.

# The one exception: `npm run eval` is a plain node script, so it reads these
# from this file rather than from the deployment. Set MODEL_API_KEY here too
# if you run it; MODEL_BASE_URL/MODEL_NAME are optional the same way.
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=

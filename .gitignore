# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# brain observation log — runtime state, rebuilt by replay
/.data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# convex auth key material — never commit
.auth-keys.json

.vercel

# local transcript export — 1.3MB, not source
session.md
